pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Code already checked out by Jenkins'
            }
        }

        stage('Start Database and App') {
            steps {
                sh 'docker-compose -f docker/docker-compose.yml up -d --build'
            }
        }

        stage('Wait for Health Check') {
            steps {
                sh 'sleep 10'
            }
        }

        stage('Seed Test Data') {
            steps {
                sh 'docker exec ecommerce_app python -m scripts.seed_data'
            }
        }

        stage('Run Newman Tests') {
            steps {
                sh '''
                newman run tests/postman/collections/ecommerce-api-collection.json \
                  -e tests/postman/environments/local-dev-environment.json \
                  --env-var "base_url=http://host.docker.internal:8001" \
                  --folder "Authentication" \
                  --folder "Cart" \
                  --folder "Orders" \
                  --folder "Payments" \
                  --folder "Negative & Boundary Tests" \
                  --folder "Regression Workflows" \
                  --reporters cli,htmlextra \
                  --reporter-htmlextra-export reports/newman-report.html
                '''
            }
        }
    }

            post {
        always {
            sh 'docker-compose -f docker/docker-compose.yml down'
            publishHTML(target: [
                allowMissing: true,
                alwaysLinkToLastBuild: true,
                keepAll: true,
                reportDir: 'reports',
                reportFiles: 'newman-report.html',
                reportName: 'Newman Test Report'
            ])
        }
    }
}